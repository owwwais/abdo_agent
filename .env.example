# ============================================================================
# وكيل البحث والمبيعات — ملف البيئة
# انسخه إلى .env ثم املأ القيم. لا ترفع .env إلى Git ولا ترسل محتواه في أي محادثة.
# أغلب مفاتيح التكاملات يمكن إدخالها من صفحة الإعدادات بدل هذا الملف (تُحفظ مشفرة)،
# وما يُحفظ في الصفحة يتقدم على القيم هنا.
# ============================================================================

# ---- 1) البيئة ---------------------------------------------------------------
# demo: كل شيء اصطناعي ولا إرسال | development: تشغيل محلي حقيقي | staging | production
APP_ENV=development
APP_TIMEZONE=Asia/Riyadh
# في الإنتاج: رابطك العام بـhttps (مثل https://sales.yourdomain.com)
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# ---- 2) قاعدة البيانات ----------------------------------------------------------
# محليًا: uv run python scripts/localdb.py start
# Supabase: Project Settings → Database → Connection string → Session pooler (أو Direct)
#   مثال: postgresql://postgres.<project-ref>:<DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:54329/sales
CHECKPOINT_DATABASE_URL=

# ---- 3) Supabase Auth (دخول المؤسسين) -------------------------------------------
# Project Settings → API: رابط المشروع والمفتاح المنشور (sb_publishable_...). آمنان للكشف.
# فعّل JWT Signing Keys (غير متماثلة) وعطّل التسجيل العام في Authentication → Providers.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated

# ---- 4) أسرار داخلية (تولد تلقائيًا: uv run python scripts/gen_secrets.py) --------
SESSION_SECRET=
# لا تغيره بعد الاستخدام: يكسر مطابقة سجل منع التواصل.
DATA_HASH_KEY=
# تشفير المفاتيح المحفوظة من صفحة الإعدادات. للتدوير: جديد,قديم (الأول للتشفير).
SECRETS_ENCRYPTION_KEY=

# دخول التطوير المحلي بلا Supabase (يُرفض تلقائيًا في staging/production).
DEV_AUTH_ENABLED=true

# ---- 5) البريد -----------------------------------------------------------------
# مفتاح إيقاف عام: لا يُرسل أي بريد لعميل حتى تجعله true، حتى بعد الاعتماد.
OUTBOUND_ENABLED=false
# اختياري: قائمة سماح للمستلمين أثناء التجربة (بريد أو @نطاق مفصولة بفواصل).
OUTBOUND_ALLOWLIST=
# Hostinger: Emails → Agentic mail → Webhooks → Add webhook (الحدث message.received)
#   الرابط: <APP_BASE_URL>/webhooks/email/hostinger — انسخ السر الذي يظهر مرة واحدة هنا.
HOSTINGER_WEBHOOK_SECRET=
# SMTP/IMAP (أو أدخلها من الإعدادات ← البريد؛ اختيار Hostinger يضبط الخوادم تلقائيًا)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_USERNAME=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=
IMAP_USERNAME=
IMAP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# ---- 6) النماذج (أو أدخلها من الإعدادات ← النماذج واختر النموذج لكل دور) -----------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=

# ---- 7) البحث وتيليجرام (أو من الإعدادات) -----------------------------------------
# Tavily: 1000 طلب مجاني شهريًا بلا بطاقة (app.tavily.com). Brave: رصيد 5$ شهريًا.
TAVILY_API_KEY=
BRAVE_SEARCH_API_KEY=
# خرائط Google: Google Cloud ← فعّل Places API (New) ← Credentials. نخزن معرف المكان فقط.
GOOGLE_MAPS_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- 8) جلب صفحات الويب لفحص المصادر والإثراء (افتراضيًا مفعل خارج demo/test) --------
# SOURCE_FETCH_ENABLED=true
