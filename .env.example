# انسخ هذا الملف إلى .env للتشغيل المحلي. لا تضع أسرارًا حقيقية في Git.
# القيم الفارغة للأسرار مسموحة فقط في demo/development/test؛ خارجها يرفض التطبيق الإقلاع.

# ---- البيئة: demo | development | test | staging | production
APP_ENV=demo
APP_TIMEZONE=Asia/Riyadh
APP_BASE_URL=http://localhost:8000
LOG_LEVEL=INFO

# ---- قاعدة البيانات (PostgreSQL). محليًا: uv run python scripts/localdb.py start
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:54329/sales
# حفظ حالة LangGraph (M2+). يمكن أن يكون القاعدة نفسها بمخطط منفصل.
CHECKPOINT_DATABASE_URL=

# ---- Supabase Auth (عام: رابط المشروع والمفتاح المنشور sb_publishable_... آمنان للكشف)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_AUDIENCE=authenticated

# ---- أسرار (مطلوبة خارج البيئات المحلية، 32 حرفًا على الأقل)
# SESSION_SECRET: يوقّع بصمات رموز الجلسات؛ تدويره يسجل خروج الجميع.
SESSION_SECRET=
# DATA_HASH_KEY: بصمات منع التواصل وجهات الاتصال؛ لا تدوره دون ترحيل بصمات.
DATA_HASH_KEY=

# ---- دخول التطوير المحلي (fixture). ممنوع خارج demo/development/test.
DEV_AUTH_ENABLED=true

# ---- تيليجرام (M3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_ID=

# ---- المزودون. demo يفرض fake لكل منها.
SEARCH_PROVIDER=fake
SEARCH_API_KEY=
MODEL_PROVIDER=fake
MODEL_EXTRACTOR_ID=
MODEL_WRITER_ID=
MODEL_API_KEY=
MAIL_PROVIDER=fake
MAIL_CREDENTIAL_REF=
OUTBOUND_ENABLED=false

# ---- جلب صفحات الويب العامة لفحص المصادر (افتراضيًا معطل في demo/test ومفعل في غيرها)
# SOURCE_FETCH_ENABLED=true

# ---- الحصص والميزانية (الميزانيات مطلوبة خارج البيئات المحلية)
MAX_QUALIFIED_PER_DAY=3
DAILY_BUDGET_AMOUNT=
MONTHLY_BUDGET_AMOUNT=
BUDGET_CURRENCY=USD
